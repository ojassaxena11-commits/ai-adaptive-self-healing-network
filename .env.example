# Cisco Modeling Labs (CML) and Device Credentials
# NEVER commit real credentials to Git

# CML Controller Host / REST API
CML_HOST=192.168.1.100
CML_PORT=443
CML_USER=cml_admin
CML_PASS=cml_password
CML_LAB_ID=ai-self-healing-lab
CML_VERIFY_SSL=false

# Cisco Switch & Router SSH Credentials
CISCO_USERNAME=admin
CISCO_PASSWORD=CHANGE_ME
CISCO_ENABLE_SECRET=CHANGE_ME
CISCO_PORT=22

# Operational Environment (SIMULATION or CML)
ENV_MODE=SIMULATION
LOG_LEVEL=INFO
