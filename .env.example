# AI-Driven Adaptive Self-Healing Network - Environment Settings
# NEVER commit real credentials to Git

# GNS3 Controller Host / REST API v2 (Default: http://localhost:3080)
GNS3_HOST=localhost
GNS3_PORT=3080
GNS3_PROTOCOL=http
GNS3_USER=admin
GNS3_PASS=
GNS3_PROJECT_NAME=AI-Self-Healing-Network

# Cisco Switch & Router SSH Credentials (Optional for live CLI automation)
CISCO_USERNAME=admin
CISCO_PASSWORD=CHANGE_ME
CISCO_ENABLE_SECRET=CHANGE_ME
CISCO_PORT=22

# Operational Environment (SIMULATION or GNS3)
ENV_MODE=SIMULATION
LOG_LEVEL=INFO
